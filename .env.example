# Variables de entorno usadas por el backend (backend/modules/geografia.py)
# Ninguna de estas variables existía en un archivo .env en el repositorio original;
# hoy se deben exportar manualmente en el entorno (o definir en docker-compose.yml).
# El backend NO usa python-dotenv, por lo que este archivo es solo referencia,
# no se carga automáticamente.

# Carpeta donde buscar el primer archivo *.gdb si GEODATA_GDB_PATH no está definida.
# Por defecto: <raiz-del-repo>/datos_geograficos (backend/modules/geografia.py:12)
GEODATA_DIR=./datos_geograficos

# Ruta exacta a un archivo .gdb específico. Tiene prioridad sobre GEODATA_DIR.
# Déjala vacía/sin definir para usar la búsqueda automática por GEODATA_DIR.
GEODATA_GDB_PATH=

# Llave usada para firmar los JWT emitidos por POST /login (backend/app.py).
# OBLIGATORIA en producción: si no se define, el backend usa un valor por
# defecto heredado del código original (solo por compatibilidad con
# despliegues existentes) que YA fue expuesto en este repositorio y por lo
# tanto se considera comprometido. Genera una nueva llave, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Ruta al archivo JSON con los usuarios/contraseñas válidos para /login.
# Por defecto: backend/users.json (junto a app.py). Copia
# backend/users.json.example a backend/users.json y completa las
# credenciales reales; ese archivo NO se versiona en git.
USERS_FILE=./backend/users.json

# --- Solo aplica si se reconstruye frontend_source/ (hoy no es posible, ver README) ---
# URL base del backend que el frontend usará en tiempo de BUILD (Create React App
# incrusta esta variable en el bundle; no se puede cambiar después de compilado).
REACT_APP_API=http://localhost:5000

# --- Ya NO viven en el código fuente desde esta refactorización: ---
# SECRET_KEY                      -> ahora viene de esta variable de entorno (ver arriba)
# Usuarios y contraseñas          -> ahora vienen de backend/users.json (ver USERS_FILE)
# Login de invitado del frontend  -> sigue hardcodeado en frontend_source/components/LoginPage.tsx:54
#                                    (no se modificó; queda pendiente, ver README "Checklist")
